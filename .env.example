# Port ARM web UI listens on
ARM_PORT=8080

# Base path for ARM config, media, logs, and db directories on the host
DOCKER_DATA_PATH=/home/arm

# NAS mount paths (must be direct mounts, not symlinks)
ARM_NAS_COMPLETED_PATH=/mnt/nas/completed
ARM_NAS_MUSIC_PATH=/mnt/nas/music

# Timezone
TZ=America/Chicago